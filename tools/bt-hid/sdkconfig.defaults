# scrcpy-cam bt-hid: BLE HID keyboard (NimBLE), console on USB Serial/JTAG
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_HID_SERVICE=y
# Keep bonds across resets of the ESP32 (and phone reboots)
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# GAP device name (shown by the phone once connected; the advertised name is set in main.c)
CONFIG_BT_NIMBLE_SVC_GAP_DEVICE_NAME="scrcpy-cam HID"

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
